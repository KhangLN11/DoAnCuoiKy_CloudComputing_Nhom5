
@model StudentFeedback.Models.ViewModels.AdminCategoryViewModel

@{
    ViewData["Title"] = "Sửa danh mục";
    Layout = "_AdminLayout";
}

<div class="category-header">
    <div>
        <h1>Chỉnh sửa danh mục</h1>
        <p>Cập nhật thông tin danh mục phản ánh.</p>
    </div>
</div>

<div class="panel" style="max-width: 750px;">
    <form asp-controller="Admin"
          asp-action="CategoryEdit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name">
                Tên danh mục <span style="color:red">*</span>
            </label>

            <input asp-for="Name"
                   class="form-control"
                   maxlength="100"
                   placeholder="Nhập tên danh mục..." />

            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Mô tả</label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="5"
                      maxlength="500"
                      placeholder="Nhập mô tả danh mục..."></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="form-actions">
            <a asp-controller="Admin"
               asp-action="Categories"
               class="btn-cancel">
                Hủy
            </a>

            <button type="submit" class="btn-save">
                Lưu thay đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
