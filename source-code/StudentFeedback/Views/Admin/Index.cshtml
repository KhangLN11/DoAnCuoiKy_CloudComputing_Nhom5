
@model StudentFeedback.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";

    var totalReflections = Model.TotalReflections;
    var completedCount = Model.ResolvedCount + Model.ClosedCount;

    var completionRate = totalReflections > 0
        ? Math.Round(completedCount * 100.0 / totalReflections, 1)
        : 0;
}

<!-- 1. THỐNG KÊ TỔNG QUAN -->
<section class="stats">
    <div class="stat-card orange">
        <h3>Tổng phản ánh</h3>
        <strong>@Model.TotalReflections</strong>
    </div>

    <div class="stat-card blue">
        <h3>Mới tạo</h3>
        <strong>@Model.PendingCount</strong>
    </div>

    <div class="stat-card yellow">
        <h3>Đang xử lý</h3>
        <strong>@Model.InProgressCount</strong>
    </div>

    <div class="stat-card green">
        <h3>Đã xử lý</h3>
        <strong>@Model.ResolvedCount</strong>
    </div>
</section>


<!-- 2. BIỂU ĐỒ THỐNG KÊ -->
<section class="charts">

    <!-- Biểu đồ theo danh mục -->
    <div class="panel">
        <h2>Thống kê theo danh mục</h2>

        @if (Model.CategoryStatistics.Any())
        {
            <div style="position: relative; height: 320px;">
                <canvas id="categoryChart"></canvas>
            </div>
        }
        else
        {
            <div class="placeholder">
                Chưa có danh mục để thống kê.
            </div>
        }
    </div>

    <!-- Biểu đồ phân bố trạng thái -->
    <div class="panel">
        <h2>Tỷ lệ xử lý</h2>

        @if (Model.TotalReflections > 0)
        {
            <div style="position: relative; height: 320px;">
                <canvas id="statusChart"></canvas>
            </div>

            <p style="text-align: center; margin-top: 12px;">
                Đã xử lý hoặc đóng:
                <strong>@completedCount / @totalReflections</strong>
                phản ánh
                (<strong>@completionRate%</strong>)
            </p>
        }
        else
        {
            <div class="placeholder">
                Chưa có phản ánh để thống kê.
            </div>
        }
    </div>

</section>


<!-- 3. DANH SÁCH PHẢN ÁNH GẦN ĐÂY -->
<section class="panel">
    <h2>Danh sách phản ánh gần đây</h2>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã phản ánh</th>
                    <th>Sinh viên</th>
                    <th>Tiêu đề</th>
                    <th>Danh mục</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.RecentReflections.Any())
                {
                    @foreach (var reflection in Model.RecentReflections)
                    {
                        var statusText = reflection.Status switch
                        {
                            "Pending" => "Mới tạo",
                            "InProgress" => "Đang xử lý",
                            "Resolved" => "Đã xử lý",
                            "Closed" => "Đã đóng",
                            _ => reflection.Status
                        };

                        <tr>
                            <td>#@reflection.Id</td>

                            <td>@reflection.StudentName</td>

                            <td>@reflection.Title</td>

                            <td>@reflection.CategoryName</td>

                            <td>@statusText</td>

                            <td>
                                @reflection.CreatedAt.ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
    <a asp-controller="Admin"
       asp-action="ReflectionDetails"
       asp-route-id="@reflection.Id">
        Xem chi tiết
    </a>
</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty">
                            Chưa có phản ánh nào trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>


@using System.Text.Json

@{
    var categoryLabels = Model.CategoryStatistics
        .Select(c => c.CategoryName)
        .ToList();

    var categoryCounts = Model.CategoryStatistics
        .Select(c => c.ReflectionCount)
        .ToList();

    var statusLabels = new[]
    {
        "Mới tạo",
        "Đang xử lý",
        "Đã xử lý",
        "Đã đóng"
    };

    var statusCounts = new[]
    {
        Model.PendingCount,
        Model.InProgressCount,
        Model.ResolvedCount,
        Model.ClosedCount
    };
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Dữ liệu được Razor chuyển từ ViewModel thành JSON.
        const categoryLabels =
            @Html.Raw(JsonSerializer.Serialize(categoryLabels));

        const categoryCounts =
            @Html.Raw(JsonSerializer.Serialize(categoryCounts));

        const statusLabels =
            @Html.Raw(JsonSerializer.Serialize(statusLabels));

        const statusCounts =
            @Html.Raw(JsonSerializer.Serialize(statusCounts));

        // 1. BIỂU ĐỒ CỘT THEO DANH MỤC
        const categoryCanvas =
            document.getElementById("categoryChart");

        if (categoryCanvas) {
            new Chart(categoryCanvas, {
                type: "bar",
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        label: "Số phản ánh",
                        data: categoryCounts,
                        backgroundColor: "#3b82f6",
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        }

        // 2. BIỂU ĐỒ DOUGHNUT THEO TRẠNG THÁI
        const statusCanvas =
            document.getElementById("statusChart");

        if (statusCanvas) {
            new Chart(statusCanvas, {
                type: "doughnut",
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusCounts,
                        backgroundColor: [
                            "#3b82f6",
                            "#f59e0b",
                            "#22c55e",
                            "#64748b"
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "65%",
                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            });
        }

    });
</script>

