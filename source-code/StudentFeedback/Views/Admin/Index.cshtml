@model StudentFeedback.Models.ViewModels.AdminDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"]="Dashboard";Layout="_AdminLayout";
    var total=Model.TotalReflections; var done=Model.ResolvedCount+Model.ClosedCount;
    var rate=total>0?Math.Round(done*100.0/total,1):0;
    var v1=total>0?Model.PendingCount*100.0/total:0;
    var v2=total>0?(Model.PendingCount+Model.InProgressCount)*100.0/total:0;
    var v3=total>0?(Model.PendingCount+Model.InProgressCount+Model.ResolvedCount)*100.0/total:0;
    var s1=v1.ToString("0.##",CultureInfo.InvariantCulture);var s2=v2.ToString("0.##",CultureInfo.InvariantCulture);var s3=v3.ToString("0.##",CultureInfo.InvariantCulture);
    var donut=$"conic-gradient(#2d85f8 0% {s1}%,#ffa51a {s1}% {s2}%,#1bc986 {s2}% {s3}%,#64748b {s3}% 100%)";
    var max=Math.Max(1,Model.CategoryStatistics.Count>0?Model.CategoryStatistics.Max(x=>x.ReflectionCount):1);
}
<div class="dashboard-heading"><h1>Tổng quan quản trị</h1><p>Theo dõi phản ánh và hoạt động xử lý của hệ thống.</p></div>
<section class="stats"><a href="/Admin/Reflections" class="stat-card orange"><span class="adm-symbol">▣</span><div><h3>Tổng phản ánh</h3><strong>@total</strong></div></a><a href="/Admin/Reflections?status=Pending" class="stat-card blue"><span class="adm-symbol">＋</span><div><h3>Mới tạo</h3><strong>@Model.PendingCount</strong></div></a><a href="/Admin/Reflections?status=InProgress" class="stat-card yellow"><span class="adm-symbol">◷</span><div><h3>Đang xử lý</h3><strong>@Model.InProgressCount</strong></div></a><a href="/Admin/Reflections?status=Resolved" class="stat-card green"><span class="adm-symbol">✓</span><div><h3>Đã xử lý</h3><strong>@Model.ResolvedCount</strong></div></a></section>
<section class="charts"><article class="panel"><h2>▥ Thống kê theo danh mục</h2>@if(Model.CategoryStatistics.Any()){<div class="category-visual">@foreach(var item in Model.CategoryStatistics){var percent=Math.Max(3,item.ReflectionCount*100.0/max);<div class="category-bar"><div class="bar-axis"><div class="bar-fill" style="height:@percent.ToString("0.##",CultureInfo.InvariantCulture)%" title="@item.CategoryName: @item.ReflectionCount"><b>@item.ReflectionCount</b></div></div><span>@item.CategoryName</span></div>}</div>}else{<p class="adm-empty">Chưa có danh mục để thống kê.</p>}</article><article class="panel"><h2>◉ Tỷ lệ xử lý</h2>@if(total>0){<div class="status-donut" style="background:@donut"><div><strong>@rate%</strong><small>Hoàn tất</small></div></div><div class="donut-legend"><span>🔵 Mới tạo</span><span>🟠 Đang xử lý</span><span>🟢 Đã xử lý</span><span>⚪ Đã đóng</span></div><p class="adm-donut-caption">Đã xử lý hoặc đóng: <b>@done / @total</b> phản ánh (@rate%)</p>}else{<p class="adm-empty">Chưa có phản ánh để thống kê.</p>}</article></section>
<section class="panel"><h2>▤ Danh sách phản ánh gần đây</h2><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Mã</th><th>Sinh viên</th><th>Tiêu đề</th><th>Danh mục</th><th>Trạng thái</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead><tbody>@if(Model.RecentReflections.Count==0){<tr><td colspan="7" class="empty">Chưa có phản ánh trong hệ thống.</td></tr>}else{@foreach(var r in Model.RecentReflections){var st=r.Status;var label=st switch{"Pending"=>"Mới tạo","InProgress"=>"Đang xử lý","Resolved"=>"Đã xử lý","Closed"=>"Đã đóng",_=>st};<tr><td><b>#@r.Id</b></td><td>@r.StudentName</td><td>@r.Title</td><td>@r.CategoryName</td><td><span class="state @st">@label</span></td><td>@r.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td><a asp-controller="Admin" asp-action="ReflectionDetails" asp-route-id="@r.Id">Xem chi tiết →</a></td></tr>}}</tbody></table></div></section>
