
@model StudentFeedback.Models.ViewModels.AdminAccountListViewModel

@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "_AdminLayout";

    var inactiveStudentCount = Model.Accounts.Count(
        a => a.Role == "Student" && !a.IsActive);
}

<div class="accounts-page">

    <!-- Tiêu đề trang -->
    <div class="accounts-page-header">
        <div>
            <h1>Quản lý tài khoản</h1>
            <p>
                Theo dõi thông tin, vai trò và trạng thái
                kích hoạt tài khoản trong hệ thống.
            </p>

            <a asp-controller="Admin"
               asp-action="ImportStudents"
               class="student-import-button"
               style="display:inline-block; text-decoration:none; margin-top:16px;">
                Nhập danh sách sinh viên (CSV)
            </a>
        </div>
    </div>

    <!-- Thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"
             role="alert"
             style="margin:16px 0; padding:12px; border-radius:8px;">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"
             role="alert"
             style="margin:16px 0; padding:12px; border-radius:8px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Thống kê tài khoản -->
    <div class="accounts-stats">

        <div class="accounts-stat-card">
            <div class="accounts-stat-label">
                Tổng tài khoản
            </div>
            <div class="accounts-stat-value">
                @Model.TotalAccounts
            </div>
        </div>

        <div class="accounts-stat-card">
            <div class="accounts-stat-label">
                Tài khoản sinh viên
            </div>
            <div class="accounts-stat-value">
                @Model.TotalStudents
            </div>
        </div>

        <div class="accounts-stat-card">
            <div class="accounts-stat-label">
                Tài khoản quản trị viên
            </div>
            <div class="accounts-stat-value">
                @Model.TotalAdmins
            </div>
        </div>

    </div>

    <!-- Danh sách tài khoản -->
    <section class="accounts-panel">

        <div class="accounts-panel-header">
            <div>
                <h2>Danh sách tài khoản</h2>
                <p>
                    Hiển thị @Model.Accounts.Count tài khoản
                    theo điều kiện tìm kiếm và lọc.
                </p>
            </div>
        </div>

        <!-- Thông báo kích hoạt qua email -->
        <div style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            flex-wrap:wrap;
            gap:12px;
            padding:16px;
            margin:16px 0;
            border:1px solid #bfdbfe;
            border-radius:10px;
            background:#eff6ff;">

            <div>
                <strong style="color:#1d4ed8;">
                    Kích hoạt tài khoản qua email
                </strong>

                <p style="margin:8px 0; color:#475569;">
                    Sinh viên chưa kích hoạt sẽ nhận liên kết
                    thiết lập mật khẩu qua email.
                    Tài khoản chỉ được kích hoạt sau khi
                    thiết lập mật khẩu thành công.
                </p>

                <small style="color:#64748b;">
                    Đang hiển thị @inactiveStudentCount
                    sinh viên chưa kích hoạt trong danh sách hiện tại.
                </small>

                <p style="margin:8px 0 0; color:#92400e; font-size:13px;">
                    Hiện đang ở chế độ kiểm thử:
                    chỉ gửi email đến địa chỉ được cấu hình trước.
                    Chức năng kích hoạt hàng loạt đã tạm khóa.
                </p>
            </div>

        </div>

        <!-- Tìm kiếm và lọc -->
        <form asp-controller="Admin"
              asp-action="Accounts"
              method="get"
              class="accounts-filter-form">

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   placeholder="Tìm theo họ tên, email hoặc mã sinh viên..."
                   class="accounts-search-input"
                   maxlength="255" />

            <select name="roleFilter"
                    class="accounts-role-select">

                <option value="">
                    Tất cả vai trò
                </option>

                <option value="Student"
                        selected="@(Model.RoleFilter == "Student")">
                    Sinh viên
                </option>

                <option value="Admin"
                        selected="@(Model.RoleFilter == "Admin")">
                    Quản trị viên
                </option>

            </select>

            <button type="submit"
                    class="accounts-search-button">
                Tìm kiếm
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.Search) ||
                 !string.IsNullOrWhiteSpace(Model.RoleFilter))
            {
                <a asp-controller="Admin"
                   asp-action="Accounts"
                   class="accounts-reset-button">
                    Xóa lọc
                </a>
            }

        </form>

        <!-- Bảng danh sách tài khoản -->
        <div class="accounts-table-wrapper">

            <table class="accounts-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Mã sinh viên</th>
                        <th>Lớp</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Accounts.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="accounts-empty">
                                Không tìm thấy tài khoản phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var account in Model.Accounts)
                        {
                            <tr>
                                <td>@account.Id</td>

                                <td>
                                    <span class="accounts-name">
                                        @account.FullName
                                    </span>
                                </td>

                                <td>@account.Email</td>

                                <td>
                                    @if (account.Role == "Admin")
                                    {
                                        <span class="accounts-role admin">
                                            Quản trị viên
                                        </span>
                                    }
                                    else if (account.Role == "Student")
                                    {
                                        <span class="accounts-role student">
                                            Sinh viên
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="accounts-role unknown">
                                            @account.Role
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(account.StudentCode)
                                        ? "—"
                                        : account.StudentCode)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(account.ClassName)
                                        ? "—"
                                        : account.ClassName)
                                </td>

                                <td>
                                    @if (account.IsActive)
                                    {
                                        <span style="
                                            display:inline-block;
                                            padding:6px 10px;
                                            border-radius:20px;
                                            background:#dcfce7;
                                            color:#166534;
                                            font-weight:600;
                                            white-space:nowrap;">
                                            Đã kích hoạt
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="
                                            display:inline-block;
                                            padding:6px 10px;
                                            border-radius:20px;
                                            background:#fef3c7;
                                            color:#92400e;
                                            font-weight:600;
                                            white-space:nowrap;">
                                            Chưa kích hoạt
                                        </span>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td>
                                    @if (account.Role == "Student" &&
                                         !account.IsActive)
                                    {
                                        <form asp-controller="AdminPasswordSetup"
                                              asp-action="SendTestEmail"
                                              method="post"
                                              onsubmit="return confirm('Gửi email thiết lập mật khẩu cho sinh viên này?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="studentId"
                                                   value="@account.Id" />

                                            <button type="submit"
                                                    style="
                                                        padding:9px 12px;
                                                        border:none;
                                                        border-radius:7px;
                                                        background:#2563eb;
                                                        color:white;
                                                        font-size:13px;
                                                        font-weight:600;
                                                        cursor:pointer;
                                                        white-space:nowrap;">
                                                Gửi email thiết lập mật khẩu
                                            </button>
                                        </form>
                                    }
                                    else if (account.Role == "Student")
                                    {
                                        <span style="
                                            color:#15803d;
                                            font-size:13px;
                                            font-weight:600;">
                                            Đã hoàn tất
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8;">
                                            —
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </section>

</div>
