
@model StudentFeedback.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - StudentFeedback</title>

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            background: #fff8f0;
            color: #263748;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: white;
            border-radius: 20px;
            padding: 36px;
            box-shadow: 0 12px 40px rgba(0,0,0,.07);
        }

        .brand {
            text-align: center;
            font-size: 25px;
            font-weight: 800;
            margin-bottom: 28px;
        }

        .brand span { color: #f58a26; }

        h2 { text-align: center; margin-bottom: 8px; }

        .subtitle {
            text-align: center;
            color: #777;
            font-size: 14px;
            margin-bottom: 28px;
        }

        label {
            display: block;
            font-weight: 600;
            margin: 16px 0 8px;
        }

        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #ddd;
            border-radius: 9px;
            font-size: 14px;
        }

        input:focus {
            outline: none;
            border-color: #f58a26;
        }

        button {
            width: 100%;
            margin-top: 24px;
            padding: 14px;
            background: #f58a26;
            border: 0;
            border-radius: 9px;
            color: white;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
        }

        button:hover { background: #e97914; }

        .validation {
            color: #c62828;
            font-size: 13px;
            margin-top: 8px;
        }
    </style>
</head>

<body>
    <div class="login-card">
        <div class="brand">
            🎓 Student<span>Feedback</span>
        </div>

        <h2>Đăng nhập</h2>
        <p class="subtitle">
            Hệ thống quản lý phản ánh sinh viên
        </p>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewData["ReturnUrl"]" />

            <div asp-validation-summary="ModelOnly"
                 class="validation"></div>

            <label asp-for="Email">Email</label>
            <input asp-for="Email"
                   type="email"
                   autocomplete="username"
                   placeholder="Nhập email của bạn" />
            <span asp-validation-for="Email"
                  class="validation"></span>

            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password"
                   type="password"
                   autocomplete="current-password"
                   placeholder="Nhập mật khẩu" />
            <span asp-validation-for="Password"
                  class="validation"></span>

            <button type="submit">Đăng nhập</button>
        </form>
    </div>
</body>
</html>
