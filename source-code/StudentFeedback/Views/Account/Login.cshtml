@model StudentFeedback.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Đăng nhập • StudentFeedback</title>
    <link rel="stylesheet" href="~/css/feedback-ui.css" asp-append-version="true" />
</head>
<body class="auth-page intranet-login">
    <div class="auth-scene">
        <div class="auth-side" aria-hidden="true">
            <img src="~/images/student-mascot.png" alt="" />
        </div>
        <main class="auth-card">
            <div class="login-brand"><span class="login-brand-mark">🎓</span> Student<span>Feedback</span></div>
            <div class="login-internal-tag">CỔNG PHẢN ÁNH NỘI BỘ</div>
            <h1>Đăng nhập</h1>
            <p>Hệ thống quản lý phản ánh sinh viên</p>
            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="flash success" role="status">@success</div>
            }
            @if (TempData["ErrorMessage"] is string error)
            {
                <div class="flash error" role="alert">@error</div>
            }
            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"])" />
                <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
                <label asp-for="Email">Email được nhà trường cấp</label>
                <div class="login-input-box">
                    <span aria-hidden="true">✉</span>
                    <input asp-for="Email" type="email" autocomplete="username" placeholder="Nhập email tài khoản" required autofocus />
                </div>
                <span asp-validation-for="Email" class="form-error"></span>
                <label asp-for="Password">Mật khẩu</label>
                <div class="password-wrap login-input-box">
                    <span aria-hidden="true">♙</span>
                    <input asp-for="Password" id="loginPassword" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required />
                    <button class="password-toggle" type="button" aria-label="Hiện mật khẩu" aria-pressed="false" onclick="const p=document.getElementById('loginPassword'); const visible=p.type==='password'; p.type=visible?'text':'password'; this.setAttribute('aria-label',visible?'Ẩn mật khẩu':'Hiện mật khẩu'); this.setAttribute('aria-pressed',String(visible)); this.textContent=visible?'Ẩn':'Hiện';">Hiện</button>
                </div>
                <span asp-validation-for="Password" class="form-error"></span>
                <button type="submit" class="btn-orange full login-submit">Đăng nhập <span aria-hidden="true">→</span></button>
            </form>
            <div class="login-private-note"><strong>Hệ thống nội bộ</strong><p>Chỉ tài khoản được quản trị viên cấp và kích hoạt mới có thể truy cập. Nếu cần cấp lại mật khẩu, vui lòng liên hệ quản trị viên của trường.</p></div>
        </main>
    </div>
</body>
</html>
