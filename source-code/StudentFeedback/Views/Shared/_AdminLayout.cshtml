
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - StudentFeedback Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a asp-controller="Admin" asp-action="Dashboard" class="admin-brand">
                <span class="brand-icon">S</span>
                <span>Student<span class="brand-orange">Feedback</span></span>
            </a>

            <div class="sidebar-caption">QUẢN LÝ HỆ THỐNG</div>

            <a asp-controller="Admin" asp-action="Dashboard" class="sidebar-link">
                <span>▦</span> Dashboard
            </a>

            <a asp-controller="Admin" asp-action="Reflections" class="sidebar-link">
                <span>▤</span> Quản lý phản ánh
            </a>

            <a asp-controller="Admin" asp-action="Categories" class="sidebar-link">
                <span>▧</span> Danh mục
            </a>

            <a asp-controller="Admin" asp-action="Users" class="sidebar-link">
                <span>♙</span> Người dùng
            </a>

            <div class="sidebar-note">
                <div class="note-icon">✦</div>
                <strong>StudentFeedback</strong>
                <p>Lắng nghe sinh viên, kiến tạo môi trường tốt hơn.</p>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-topbar">
                <div>
                    <span class="topbar-label">HỆ THỐNG QUẢN LÝ</span>
                    <div class="fw-bold">Khu vực quản trị</div>
                </div>

                <div class="admin-profile">
                    <div class="admin-avatar">A</div>
                    <div>
                        <strong>Admin</strong>
                        <small>Quản trị viên</small>
                    </div>
                </div>
            </header>

            <section class="admin-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                @RenderBody()
            </section>

            <footer class="admin-footer">
                StudentFeedback · Hệ thống quản lý phản ánh sinh viên
            </footer>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
