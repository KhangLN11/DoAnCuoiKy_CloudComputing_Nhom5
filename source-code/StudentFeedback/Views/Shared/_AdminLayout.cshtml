@{var action=ViewContext.RouteData.Values["action"]?.ToString()??"";var inReflection=action=="Reflections"||action=="ReflectionDetails";var inCategory=action.StartsWith("Category")||action=="Categories";var inStudents=action=="Students"||action=="StudentDetails";var inAccounts=action=="Accounts"||action=="ImportStudents"||action=="CreateStudentAccount"||action=="SetStudentPassword";}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] • Quản trị StudentFeedback</title><link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true"><link rel="stylesheet" href="~/css/feedback-ui.css" asp-append-version="true"><link rel="stylesheet" href="~/css/admin/admin-theme.css" asp-append-version="true"></head><body class="dashboard-page admin-theme"><header class="app-topbar admin-topbar"><a asp-controller="Admin" asp-action="Index" class="brand">🎓 Student<span>Feedback</span></a><div class="top-actions"><span class="account-name"><span class="avatar">AD</span><span><strong>@User.Identity?.Name</strong><small>Tài khoản quản trị viên</small></span></span><form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn-logout" type="submit">⇥ Đăng xuất</button></form></div></header><div class="app-layout"><aside class="app-sidebar"><nav class="side-menu" aria-label="Menu quản trị"><a asp-controller="Admin" asp-action="Index" class="@(action=="Index"?"active":"")"><i>⌂</i>Dashboard</a><a asp-controller="Admin" asp-action="Reflections" class="@(inReflection?"active":"")"><i>✎</i>Quản lý phản ánh</a><a asp-controller="Admin" asp-action="Categories" class="@(inCategory?"active":"")"><i>▤</i>Danh mục</a><a asp-controller="Admin" asp-action="Students" class="@(inStudents?"active":"")"><i>♙</i>Sinh viên</a><a asp-controller="Admin" asp-action="Accounts" class="@(inAccounts?"active":"")"><i>⚙</i>Tài khoản</a></nav><div class="sidebar-decoration"><img src="~/images/books.png" alt="Trang trí sách" /></div></aside><main class="app-content admin-container">@RenderBody()</main></div>@await RenderSectionAsync("Scripts",required:false)</body></html>
