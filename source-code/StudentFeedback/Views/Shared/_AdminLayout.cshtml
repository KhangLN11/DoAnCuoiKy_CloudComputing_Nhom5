
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - StudentFeedback</title>

    <link rel="stylesheet" href="~/css/admin/admin.css"
          asp-append-version="true" />
</head>
<body>
    <header class="admin-navbar">
        <div class="admin-brand">
            🎓 Student<span>Feedback</span>
        </div>

        <nav class="admin-nav" aria-label="Điều hướng quản trị">
            <a asp-controller="Admin"
               asp-action="Index"
               class="@(currentAction == "Index" ? "active" : "")">
                Dashboard
            </a>

            <a asp-controller="Admin"
               asp-action="Reflections"
               class="@(currentAction == "Reflections" ? "active" : "")">
                Phản ánh
            </a>

            <a asp-controller="Admin"
               asp-action="Categories"
               class="@(currentAction == "Categories" ? "active" : "")">
                Danh mục
            </a>

            <a asp-controller="Admin"
               asp-action="Students"
               class="@(currentAction == "Students" ? "active" : "")">
                Sinh viên
            </a>

            <a asp-controller="Admin"
               asp-action="Accounts"
               class="@(currentAction == "Accounts" ? "active" : "")">
                Tài khoản
            </a>
        </nav>

        <div class="admin-user">
            <span>@User.Identity?.Name</span>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn">
                    Đăng xuất
                </button>
            </form>
        </div>
    </header>

    <main class="admin-container">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
