
@using System.Security.Claims

@{
    var pageTitle = ViewData["Title"]?.ToString()
        ?? "Trang sinh viên";

    var studentName = User.FindFirstValue(ClaimTypes.Name);

    if (string.IsNullOrWhiteSpace(studentName))
    {
        studentName = "Sinh viên";
    }

    var studentCode = User.FindFirstValue("StudentCode");

    if (string.IsNullOrWhiteSpace(studentCode))
    {
        studentCode = "Tài khoản sinh viên";
    }

    var avatarText = "SV";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@pageTitle - StudentFeedback</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/student/student.css"
          asp-append-version="true" />

    <style>
        .student-notification-link {
            position: relative;
            text-decoration: none;
        }

        .student-notification-count {
            position: absolute;
            top: -5px;
            right: -9px;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            border-radius: 12px;
            background: #e53935;
            color: white;
            font-size: 10px;
            font-weight: 800;
            display: none;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .student-account-link {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: inherit;
        }

        .student-account-link:hover {
            color: #f28c19;
        }

        .student-notification-link:focus-visible,
        .student-account-link:focus-visible {
            outline: 3px solid #ffa726;
            outline-offset: 4px;
            border-radius: 6px;
        }
    </style>
</head>

<body class="student-body">

    <header class="student-header">
        <div class="student-header-inner">

            <a class="student-brand"
               asp-controller="Student"
               asp-action="Index"
               aria-label="StudentFeedback - Trang chủ">

                <span class="student-brand-mark">
                    <svg viewBox="0 0 64 64"
                         aria-hidden="true">
                        <path d="M4 20 32 7l28 13-28 13L4 20Z"
                              fill="#FFA726" />
                        <path d="M16 29v15c0 7 32 7 32 0V29L32 36 16 29Z"
                              fill="#F28C19" />
                        <path d="M20 32h31v19H37l-8 7v-7h-9V32Z"
                              fill="#FFA726"
                              stroke="white"
                              stroke-width="2" />
                        <circle cx="29" cy="42" r="2"
                                fill="white" />
                        <circle cx="36" cy="42" r="2"
                                fill="white" />
                        <circle cx="43" cy="42" r="2"
                                fill="white" />
                    </svg>
                </span>

                <span class="student-brand-name">
                    Student<span>Feedback</span>
                </span>
            </a>

            <nav class="student-navigation"
                 aria-label="Điều hướng sinh viên">

                <a class="student-nav-home"
                   asp-controller="Student"
                   asp-action="Index">
                    Trang chủ
                </a>

                <a class="student-nav-primary"
                   asp-controller="Student"
                   asp-action="List">
                    Xem danh sách phản ánh
                </a>

                <a class="student-notification student-notification-link"
                   asp-controller="StudentNotifications"
                   asp-action="Index"
                   aria-label="Thông báo"
                   title="Xem thông báo">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
                    </svg>

                    <span id="studentNotificationCount"
                          class="student-notification-count"
                          aria-hidden="true"></span>
                </a>

                <div class="student-account">

                    <a class="student-account-link"
                       asp-controller="StudentProfile"
                       asp-action="Index"
                       title="Xem thông tin cá nhân">

                        <div class="student-avatar">
                            @avatarText
                        </div>

                        <div class="student-account-info">
                            <strong>@studentName</strong>
                            <small>@studentCode</small>
                        </div>

                        <span class="student-chevron">⌄</span>
                    </a>
                </div>
            </nav>
        </div>
    </header>

    <main class="student-main">
        @RenderBody()
    </main>

    <footer class="student-footer">
        StudentFeedback — Cùng nhau xây dựng
        môi trường học tập tốt hơn!
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/student/student.js"
            asp-append-version="true">
    </script>

    <script>
        (() => {
            const badge = document.getElementById(
                'studentNotificationCount');

            if (!badge) return;

            const url = '@Url.Action(
                "UnreadCount",
                "StudentNotifications")';

            async function loadUnreadCount() {
                try {
                    const response = await fetch(url, {
                        credentials: 'same-origin',
                        cache: 'no-store'
                    });

                    if (!response.ok) return;

                    const data = await response.json();
                    const count = Number(data.count) || 0;

                    if (count > 0) {
                        badge.textContent =
                            count > 99 ? '99+' : String(count);

                        badge.style.display = 'flex';
                    } else {
                        badge.textContent = '';
                        badge.style.display = 'none';
                    }
                } catch (error) {
                    console.error(
                        'Không thể tải số thông báo chưa đọc.',
                        error);
                }
            }

            loadUnreadCount();

            // Cập nhật lại khi quay về tab trình duyệt.
            document.addEventListener(
                'visibilitychange',
                () => {
                    if (!document.hidden) {
                        loadUnreadCount();
                    }
                });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
