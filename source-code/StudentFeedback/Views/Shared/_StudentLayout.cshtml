@{
 var currentAction=ViewContext.RouteData.Values["action"]?.ToString();
 var isList=currentAction=="List"||currentAction=="Details";
 var displayName=User.Identity?.Name??"Sinh viên";
}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] • StudentFeedback</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/feedback-ui.css" asp-append-version="true"></head>
<body class="dashboard-page student-theme"><header class="app-topbar"><a href="/Student" class="brand">🎓 Student<span>Feedback</span></a><form class="global-search" method="get" action="/Student/List"><span>⌕</span><input name="search" aria-label="Tìm phản ánh của tôi" placeholder="Tìm kiếm phản ánh..."></form><div class="top-actions"><a href="/Student/Index#responses" class="top-bell" aria-label="Thông báo">♧</a><a href="/Student/Index#student-account" class="account-name"><span class="avatar">SV</span><span><strong>@displayName</strong><small>Tài khoản sinh viên</small></span></a><form method="post" asp-controller="Account" asp-action="Logout">@Html.AntiForgeryToken()<button type="submit" class="btn-logout">⇥ Đăng xuất</button></form></div></header>
<div class="app-layout"><aside class="app-sidebar"><nav class="side-menu" aria-label="Menu sinh viên"><a href="/Student" class="@(currentAction=="Index"?"active":"")"><i>⌂</i>Trang chủ</a><a href="/Student/Create" class="@(currentAction=="Create"?"active":"")"><i>✎</i>Tạo phản ánh</a><a href="/Student/List" class="@(isList?"active":"")"><i>▤</i>Danh sách phản ánh</a><a href="/Student/Index#student-account" class="@(currentAction=="Index"?"active":"")"><i>♙</i>Thông tin tài khoản</a><a href="/Student/Index#responses" class="@(currentAction=="Index"?"active":"")"><i>♧</i>Phản hồi Admin</a></nav><div class="sidebar-decoration"><img src="~/images/books.png" alt="Trang trí sách và mũ tốt nghiệp" /></div></aside><main class="app-content">@if(TempData["SuccessMessage"] is string ok){<div class="flash success" role="status">@ok</div>}@if(TempData["ErrorMessage"] is string err){<div class="flash error" role="alert">@err</div>}@RenderBody()</main></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/feedback-ui.js" asp-append-version="true"></script><script src="~/js/student-api-ui.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
