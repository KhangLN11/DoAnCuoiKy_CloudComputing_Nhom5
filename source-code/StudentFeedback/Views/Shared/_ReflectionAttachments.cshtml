
@model IEnumerable<StudentFeedback.Models.Attachment>

@{
    var attachments = Model
        .OrderBy(a => a.Id)
        .ToList();
}

<style>
    .sf-attachment-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .sf-attachment-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        padding: 15px 17px;
        border: 1px solid #e8edf2;
        border-radius: 10px;
        background: #f8fafc;
    }

    .sf-attachment-info {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .sf-attachment-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: #fff0df;
        font-size: 21px;
    }

    .sf-attachment-name {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #334155;
        overflow-wrap: anywhere;
    }

    .sf-attachment-size {
        display: block;
        margin-top: 4px;
        color: #64748b;
        font-size: 12px;
    }

    .sf-attachment-download {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        padding: 10px 16px;
        background: #ffa726;
        color: #fff !important;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .sf-attachment-download:hover {
        background: #f28c19;
    }

    .sf-attachment-empty {
        padding: 18px;
        background: #f8fafc;
        border: 1px dashed #dce3eb;
        border-radius: 9px;
        color: #64748b;
        font-size: 13px;
    }
</style>

@if (attachments.Count == 0)
{
    <div class="sf-attachment-empty">
        📎 Phản ánh này không có tệp minh chứng.
    </div>
}
else
{
    <div class="sf-attachment-list">

        @foreach (var attachment in attachments)
        {
            var isPdf = attachment.ContentType == "application/pdf";

            <div class="sf-attachment-row">

                <div class="sf-attachment-info">

                    <span class="sf-attachment-icon"
                          aria-hidden="true">
                        @(isPdf ? "📄" : "🖼️")
                    </span>

                    <div>
                        <strong class="sf-attachment-name">
                            @attachment.FileName
                        </strong>

                        <small class="sf-attachment-size">
                            @((attachment.FileSize / 1024.0).ToString("N1")) KB
                            · @(isPdf ? "PDF" : "Hình ảnh")
                        </small>
                    </div>
                </div>

                <a asp-controller="AttachmentDownload"
                   asp-action="Download"
                   asp-route-id="@attachment.Id"
                   class="sf-attachment-download"
                   aria-label="Tải xuống @attachment.FileName">
                    ↓ Tải xuống
                </a>

            </div>
        }

    </div>
}
