
@model StudentFeedback.Models.ViewModels.PasswordSetupViewModel

@{
    ViewData["Title"] = "Thiết lập mật khẩu";
}

<div style="
    max-width:480px;
    margin:60px auto;
    padding:30px;
    background:white;
    border-radius:14px;
    box-shadow:0 8px 30px rgba(0,0,0,0.08);">

    <h2 style="margin-bottom:10px;">
        Thiết lập mật khẩu
    </h2>

    <p style="color:#64748b; margin-bottom:24px;">
        Tạo mật khẩu cá nhân để đăng nhập vào hệ thống
        phản ánh sinh viên.
    </p>

    <form asp-controller="PasswordSetup"
          asp-action="Index"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Token" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             style="color:#dc2626; margin-bottom:16px;">
        </div>

        <div style="margin-bottom:18px;">
            <label asp-for="NewPassword"
                   style="display:block; margin-bottom:8px; font-weight:600;">
            </label>

            <input asp-for="NewPassword"
                   type="password"
                   autocomplete="new-password"
                   style="
                       width:100%;
                       padding:12px;
                       border:1px solid #cbd5e1;
                       border-radius:8px;" />

            <span asp-validation-for="NewPassword"
                  style="color:#dc2626; font-size:13px;">
            </span>
        </div>

        <div style="margin-bottom:22px;">
            <label asp-for="ConfirmPassword"
                   style="display:block; margin-bottom:8px; font-weight:600;">
            </label>

            <input asp-for="ConfirmPassword"
                   type="password"
                   autocomplete="new-password"
                   style="
                       width:100%;
                       padding:12px;
                       border:1px solid #cbd5e1;
                       border-radius:8px;" />

            <span asp-validation-for="ConfirmPassword"
                  style="color:#dc2626; font-size:13px;">
            </span>
        </div>

        <button type="submit"
                style="
                    width:100%;
                    padding:13px;
                    border:none;
                    border-radius:8px;
                    background:#2563eb;
                    color:white;
                    font-weight:600;
                    cursor:pointer;">
            Lưu mật khẩu
        </button>
    </form>

    <p style="
        margin-top:20px;
        text-align:center;
        font-size:13px;
        color:#64748b;">
        Liên kết thiết lập mật khẩu có thời hạn 30 phút
        và chỉ sử dụng được một lần.
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
