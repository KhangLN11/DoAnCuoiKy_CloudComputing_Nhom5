
@{
    ViewData["Title"] = "Liên kết không hợp lệ";
}

<div style="
    max-width:480px;
    margin:80px auto;
    padding:32px;
    background:white;
    border-radius:14px;
    text-align:center;
    box-shadow:0 8px 30px rgba(0,0,0,0.08);">

    <h2 style="color:#dc2626;">
        Liên kết không hợp lệ
    </h2>

    <p style="
        margin-top:16px;
        color:#64748b;
        line-height:1.7;">
        Liên kết thiết lập mật khẩu đã hết hạn,
        đã được sử dụng hoặc không tồn tại.
    </p>

    <p style="color:#64748b;">
        Vui lòng liên hệ quản trị viên để được
        cấp liên kết mới.
    </p>

    <a asp-controller="Account"
       asp-action="Login"
       style="
           display:inline-block;
           margin-top:18px;
           padding:12px 20px;
           border-radius:8px;
           background:#2563eb;
           color:white;
           text-decoration:none;">
        Quay lại đăng nhập
    </a>
</div>
