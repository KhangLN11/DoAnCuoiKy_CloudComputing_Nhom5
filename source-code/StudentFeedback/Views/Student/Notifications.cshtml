
@model StudentFeedback.Models.ViewModels.StudentNotificationViewModel

@{
    ViewData["Title"] = "Thông báo";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var vietnamTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
        "Asia/Ho_Chi_Minh");
}

<style>
    .sf-notifications {
        max-width: 1050px;
        margin: 12px auto 50px;
    }

    .sf-notifications h1 {
        color: #2d3748;
        font-size: 25px;
        font-weight: 800;
    }

    .sf-notification-card {
        background: #fff;
        border: 1px solid #e9edf2;
        border-radius: 14px;
        box-shadow: 0 4px 18px #2434480a;
        overflow: hidden;
    }

    .sf-notification-item {
        display: flex;
        gap: 16px;
        padding: 22px;
        border-bottom: 1px solid #edf0f4;
        transition: background .2s;
    }

    .sf-notification-item:last-child {
        border-bottom: none;
    }

    .sf-notification-item.unread {
        background: #fffaf3;
        border-left: 4px solid #ffa726;
    }

    .sf-notification-item.read {
        border-left: 4px solid transparent;
    }

    .sf-notification-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: #fff0df;
        color: #f28c19;
        display: grid;
        place-items: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .sf-notification-content {
        flex: 1;
        min-width: 0;
    }

    .sf-notification-title {
        color: #2d3748;
        font-size: 15px;
        font-weight: 750;
        margin-bottom: 7px;
    }

    .sf-notification-text {
        color: #687586;
        font-size: 13px;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .sf-notification-time {
        color: #8b97a5;
        font-size: 12px;
    }

    .sf-notification-button {
        background: #ffa726;
        border: none;
        color: white;
        font-weight: 700;
        border-radius: 8px;
        padding: 10px 17px;
        font-size: 12px;
    }

    .sf-notification-button:hover {
        background: #f28c19;
        color: white;
    }

    .sf-notification-empty {
        padding: 65px 20px;
        text-align: center;
    }

    @@media (max-width: 576px) {
        .sf-notification-item {
            padding: 16px;
            gap: 12px;
        }

        .sf-notification-icon {
            width: 38px;
            height: 38px;
        }

        .sf-notifications h1 {
            font-size: 21px;
        }
    }
</style>

<div class="sf-notifications container">

    <a asp-controller="Student"
       asp-action="Index"
       class="text-decoration-none d-inline-block mb-4"
       style="color:#64748b">
        ← Quay lại trang chủ
    </a>

    <div class="d-flex justify-content-between
                align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-2">Thông báo của bạn</h1>
            <p class="text-secondary small mb-0">
                Theo dõi cập nhật và phản hồi từ Admin.
            </p>
        </div>

        @if (Model.UnreadCount > 0)
        {
            <form asp-controller="StudentNotifications"
                  asp-action="MarkAllRead"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="sf-notification-button">
                    ✓ Đánh dấu tất cả đã đọc
                </button>
            </form>
        }
    </div>

    @if (TempData["NotificationSuccess"] is string message)
    {
        <div class="alert alert-success" role="status">
            @message
        </div>
    }

    <div class="d-flex flex-wrap gap-3 mb-4">
        <div class="bg-white border rounded-3 px-3 py-2">
            <span class="text-secondary small">
                Tổng thông báo:
            </span>
            <strong>@Model.TotalCount</strong>
        </div>

        <div class="bg-white border rounded-3 px-3 py-2">
            <span class="text-secondary small">
                Chưa đọc:
            </span>
            <strong style="color:#f28c19">
                @Model.UnreadCount
            </strong>
        </div>
    </div>

    <section class="sf-notification-card">

        @if (Model.Items.Count == 0)
        {
            <div class="sf-notification-empty">
                <div style="font-size:55px"
                     aria-hidden="true">🔔</div>

                <h2 class="fs-5 fw-bold mt-3">
                    Chưa có thông báo
                </h2>

                <p class="text-secondary small mb-4">
                    Khi Admin cập nhật trạng thái hoặc gửi
                    phản hồi, thông báo sẽ xuất hiện tại đây.
                </p>

                <a asp-controller="Student"
                   asp-action="List"
                   class="btn sf-notification-button">
                    Xem danh sách phản ánh
                </a>
            </div>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                var localTime = TimeZoneInfo.ConvertTimeFromUtc(
                    DateTime.SpecifyKind(
                        item.CreatedAt,
                        DateTimeKind.Utc),
                    vietnamTimeZone);

                <article class="sf-notification-item @(item.IsRead ? "read" : "unread")">

                    <div class="sf-notification-icon"
                         aria-hidden="true">
                        @(item.Type == "AdminReplied" ? "💬" : "🔔")
                    </div>

                    <div class="sf-notification-content">

                        <div class="d-flex justify-content-between
                                    align-items-start gap-2 flex-wrap">

                            <h2 class="sf-notification-title">
                                @item.Title
                            </h2>

                            @if (!item.IsRead)
                            {
                                <span class="badge bg-warning text-dark">
                                    Chưa đọc
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border">
                                    Đã đọc
                                </span>
                            }
                        </div>

                        <p class="sf-notification-text mb-2">
                            @item.Content
                        </p>

                        <div class="sf-notification-time mb-3">
                            @localTime.ToString("dd/MM/yyyy HH:mm")
                            · PF@(item.ReflectionId.ToString("D4"))
                        </div>

                        <form asp-controller="StudentNotifications"
                              asp-action="Open"
                              asp-route-id="@item.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm sf-notification-button">
                                Xem phản ánh →
                            </button>
                        </form>

                    </div>
                </article>
            }
        }

    </section>
</div>
