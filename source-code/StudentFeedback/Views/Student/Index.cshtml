@{ ViewData["Title"]="Trang chủ sinh viên"; Layout="_StudentLayout"; var name=User.Identity?.Name??"Sinh viên"; var email=User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value??""; }
<section class="student-welcome" id="student-account"><div class="welcome-copy"><span>Xin chào,</span><h1>@name <small>Sinh viên</small></h1><p>🎓 <strong>Tài khoản:</strong> Do quản trị viên cấp</p><p>✉ <strong>Email:</strong> @email</p><p class="small text-muted">Mã sinh viên và lớp được quản trị viên quản lý.</p></div><img src="~/images/student-mascot.png" alt="Minh họa sinh viên"/><aside><strong>Student<span>Feedback</span></strong><p>Mỗi phản ánh của bạn là một bước tiến để xây dựng môi trường học tập tốt hơn!</p></aside></section>
<div class="sf-client-alert" role="alert" id="loadError" hidden></div>
<section class="stat-grid student-stats"><a href="/Student/List" class="mini-stat orange"><span class="stat-symbol">▣</span><div><b>Tổng phản ánh</b><strong id="totalCount">—</strong><small>Tất cả phản ánh của bạn</small></div><span class="stat-arrow">›</span></a><a href="/Student/List?status=InProgress" class="mini-stat blue"><span class="stat-symbol">◷</span><div><b>Đang xử lý</b><strong id="progressCount">—</strong><small>Cần theo dõi</small></div><span class="stat-arrow">›</span></a><a href="/Student/List?status=Resolved" class="mini-stat green"><span class="stat-symbol">✓</span><div><b>Đã xử lý</b><strong id="resolvedCount">—</strong><small>Đã giải quyết</small></div><span class="stat-arrow">›</span></a><a href="/Student/List?status=Pending" class="mini-stat pink"><span class="stat-symbol">＋</span><div><b>Mới tạo</b><strong id="pendingCount">—</strong><small>Chờ tiếp nhận</small></div><span class="stat-arrow">›</span></a></section>
<h2 class="section-title">Truy cập nhanh</h2><section class="quick-grid"><a href="/Student/Create" class="quick-item orange"><span>📝</span><b>Tạo phản ánh</b><small>Gửi ý kiến, phản ánh của bạn</small><i>→</i></a><a href="/Student/List" class="quick-item blue"><span>📋</span><b>Danh sách phản ánh</b><small>Xem và theo dõi những phản ánh đã gửi</small><i>→</i></a><a href="#student-account" class="quick-item violet"><span>♙</span><b>Thông tin tài khoản</b><small>Xem họ tên và email đăng nhập</small><i>→</i></a><a href="#responses" class="quick-item yellow"><span>🔔</span><b>Phản hồi Admin</b><small>Xem phản hồi đã nhận</small><i>→</i></a></section>
<section class="surface" id="responses" style="margin-top:22px"><h2 style="font-size:20px;font-weight:850">Phản hồi gần đây</h2><div id="responseList" class="sf-client-list"><p>Đang tải phản hồi…</p></div></section>
<section class="student-callout"><div><h2>Gửi phản ánh ngay</h2><p>Chung tay xây dựng môi trường học tập tốt hơn.</p><a class="btn-orange" href="/Student/Create">Tạo phản ánh →</a></div><span aria-hidden="true">✉️</span></section>
@section Scripts{<script>window.StudentUI.initHome();</script>}
