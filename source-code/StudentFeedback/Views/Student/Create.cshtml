@{ ViewData["Title"]="Tạo phản ánh";Layout="_StudentLayout";}
<section class="page-banner"><div class="banner-icon">📝</div><div><h1>Tạo phản ánh mới</h1><p>Mô tả rõ vấn đề để nhà trường tiếp nhận và xử lý.</p></div><span class="banner-deco">✎</span></section>
<div class="content-split"><section class="surface form-surface"><form id="feedbackCreate" novalidate><div id="createMessage" class="sf-client-alert" role="alert" hidden></div><div class="field"><label for="titleInput">Tiêu đề phản ánh <em>*</em></label><input id="titleInput" name="title" maxlength="200" required placeholder="Nhập tiêu đề phản ánh..."/></div><div class="field"><label for="categoryInput">Danh mục <em>*</em></label><select id="categoryInput" name="categoryId" required><option value="">Đang tải danh mục…</option></select></div><div class="field"><label for="contentInput">Nội dung phản ánh <em>*</em></label><textarea id="contentInput" name="content" rows="7" maxlength="4000" required placeholder="Mô tả vấn đề, địa điểm và thời gian liên quan…"></textarea><div class="field-hint"><span>Hãy cung cấp thông tin đúng sự thật</span><span><b id="textLength">0</b>/4000</span></div></div><div class="sf-note-inline"><strong>Minh chứng:</strong> Backend hiện tại chưa cung cấp API tải tệp đính kèm. Vui lòng mô tả đầy đủ trong nội dung phản ánh.</div><div class="form-actions"><a href="/Student" class="btn-light">Hủy</a><button id="submitReflection" type="submit" class="btn-orange">Gửi phản ánh →</button></div></form></section><aside class="note-card"><h2>✦ Lưu ý</h2><ul><li>Cung cấp thông tin chính xác và đầy đủ.</li><li>Nêu rõ vấn đề, địa điểm và thời gian khi có thể.</li><li>Kiểm tra lại nội dung trước khi gửi.</li><li>Theo dõi phản hồi trong danh sách phản ánh.</li></ul><div class="note-art">✉</div><p>Mỗi phản ánh góp phần xây dựng môi trường học tập tốt hơn.</p></aside></div>
@section Scripts{<script>window.StudentUI.initCreate();</script>}
