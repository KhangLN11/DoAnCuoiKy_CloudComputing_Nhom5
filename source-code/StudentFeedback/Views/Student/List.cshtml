@{ ViewData["Title"]="Danh sách phản ánh"; Layout="_StudentLayout"; }
<section class="page-banner banner-list"><div class="banner-icon">📋</div><div><h1>Danh sách phản ánh của tôi</h1><p>Theo dõi tiến độ xử lý các phản ánh đã gửi.</p></div><a class="btn-orange" href="/Student/Create">＋ Tạo phản ánh</a></section>
<section class="surface"><form id="listFilters" class="filters-row" style="margin-bottom:12px"><input type="search" name="search" id="searchTerm" placeholder="Tìm theo tiêu đề, nội dung, mã phản ánh…" aria-label="Tìm phản ánh"/><select id="categoryFilter" aria-label="Chọn danh mục"><option value="">Tất cả danh mục</option></select><button type="submit" class="btn-orange">Tìm kiếm</button></form><div class="status-tabs" id="statusTabs"><button type="button" data-status="" class="active">Tất cả</button><button type="button" data-status="Pending">Mới tạo</button><button type="button" data-status="InProgress">Đang xử lý</button><button type="button" data-status="Resolved">Đã xử lý</button><button type="button" data-status="Closed">Đã đóng</button></div><div id="listMessage" class="sf-client-alert" role="status" hidden></div><div class="table-responsive"><table class="feedback-table"><thead><tr><th>Mã</th><th>Tiêu đề</th><th>Danh mục</th><th>Trạng thái</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead><tbody id="reflectionRows"><tr><td colspan="6">Đang tải dữ liệu…</td></tr></tbody></table></div><div class="pagination-bar"><small id="listCount">Đang tải…</small><div id="listPaging"></div></div></section>
@section Scripts{<script>window.StudentUI.initList();</script>}
