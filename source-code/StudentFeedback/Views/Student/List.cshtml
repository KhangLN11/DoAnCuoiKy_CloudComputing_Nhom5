
@model StudentFeedback.Models.ViewModels.StudentReflectionListViewModel

@{
    ViewData["Title"] = "Danh sách phản ánh";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    string StatusText(string status) => status switch
    {
        "Pending" => "Mới tạo",
        "InProgress" => "Đang xử lý",
        "Resolved" => "Đã xử lý",
        "Closed" => "Đã đóng",
        _ => status
    };

    string StatusClass(string status) => status switch
    {
        "Pending" => "sf-new",
        "InProgress" => "sf-working",
        "Resolved" => "sf-done",
        "Closed" => "sf-closed",
        _ => "sf-closed"
    };

    var startItem = Model.TotalItems == 0
        ? 0
        : (Model.Page - 1) * Model.PageSize + 1;

    var endItem = Math.Min(
        Model.Page * Model.PageSize,
        Model.TotalItems);
}

<style>
    .sf-list {
        max-width: 1120px;
        margin: 12px auto 50px;
    }

    .sf-list h1 {
        font-size: 25px;
        font-weight: 800;
        color: #2d3748;
    }

    .sf-list .sf-card {
        background: #fff;
        border: 1px solid #edf0f4;
        border-radius: 14px;
        box-shadow: 0 4px 18px #2434480a;
    }

    .sf-list .sf-btn {
        display: inline-block;
        background: #ffa726;
        color: #fff;
        border: 0;
        border-radius: 7px;
        padding: 11px 20px;
        font-weight: 700;
        text-decoration: none;
    }

    .sf-list .sf-btn:hover {
        background: #f28c19;
        color: #fff;
    }

    .sf-list .sf-filter {
        border: 1px solid #e5eaf0;
        background: #f8fafc;
        border-radius: 7px;
        padding: 9px 14px;
        color: #657283;
        text-decoration: none;
        display: inline-block;
    }

    .sf-list .sf-filter.active {
        background: #ffa726;
        border-color: #ffa726;
        color: #fff;
    }

    .sf-list .sf-table {
        font-size: 13px;
        min-width: 790px;
    }

    .sf-list .sf-table th {
        background: #f8fafc;
        color: #506276;
        padding: 15px;
    }

    .sf-list .sf-table td {
        padding: 17px 15px;
        vertical-align: middle;
    }

    .sf-list .sf-state {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .sf-list .sf-new {
        background: #fff0ed;
        color: #ce665d;
    }

    .sf-list .sf-working {
        background: #fff3da;
        color: #b78620;
    }

    .sf-list .sf-done {
        background: #e8f8ef;
        color: #218b63;
    }

    .sf-list .sf-closed {
        background: #eff1f4;
        color: #6e7b8a;
    }

    .sf-list .sf-page {
        display: inline-block;
        padding: 7px 12px;
        border: 1px solid #e5eaf0;
        border-radius: 6px;
        color: #506276;
        text-decoration: none;
    }

    .sf-list .sf-page.active {
        background: #ffa726;
        border-color: #ffa726;
        color: #fff;
    }

    .sf-list .sf-page.disabled {
        opacity: .45;
        pointer-events: none;
    }
</style>

<div class="sf-list container">

    
@if (TempData["StudentSuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Đóng"></button>
    </div>
}


    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-2">
                Danh sách phản ánh của tôi
            </h1>
            <p class="text-secondary small mb-0">
                Theo dõi tiến độ xử lý các phản ánh đã gửi.
            </p>
        </div>

        <a asp-controller="Student"
           asp-action="Create"
           class="sf-btn">
            + Tạo phản ánh
        </a>
    </div>

    <section class="sf-card p-4">

        <!-- TÌM KIẾM VÀ DANH MỤC -->
        <form asp-controller="Student"
              asp-action="List"
              method="get"
              class="row g-2 mb-3">

            <div class="col-md-7">
                <input type="search"
                       name="search"
                       value="@Model.Search"
                       class="form-control py-2"
                       placeholder="Tìm tiêu đề, nội dung, mã PF..."
                       aria-label="Tìm kiếm phản ánh" />
            </div>

            <div class="col-md-3">
                <select name="categoryId"
                        class="form-select py-2"
                        aria-label="Lọc danh mục">

                    <option value="">Tất cả danh mục</option>

                    @foreach (var category in Model.Categories)
                    {
                        if (Model.CategoryId == category.Id)
                        {
                            <option value="@category.Id" selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <input type="hidden"
                   name="status"
                   value="@Model.Status" />

            <div class="col-md-2">
                <button type="submit"
                        class="sf-btn w-100">
                    Tìm kiếm
                </button>
            </div>
        </form>

        <!-- LỌC TRẠNG THÁI -->
        <div class="d-flex flex-wrap gap-2 mb-4">

            <a asp-action="List"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-status="all"
               class="sf-filter @(Model.Status == "all" ? "active" : "")">
                Tất cả
            </a>

            <a asp-action="List"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-status="Pending"
               class="sf-filter @(Model.Status == "Pending" ? "active" : "")">
                Mới tạo
            </a>

            <a asp-action="List"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-status="InProgress"
               class="sf-filter @(Model.Status == "InProgress" ? "active" : "")">
                Đang xử lý
            </a>

            <a asp-action="List"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-status="Resolved"
               class="sf-filter @(Model.Status == "Resolved" ? "active" : "")">
                Đã xử lý
            </a>

            <a asp-action="List"
               asp-route-search="@Model.Search"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-status="Closed"
               class="sf-filter @(Model.Status == "Closed" ? "active" : "")">
                Đã đóng
            </a>
        </div>

        <!-- BẢNG PHẢN ÁNH -->
        <div class="table-responsive">
            <table class="table table-hover sf-table mb-0">
                <thead>
                    <tr>
                        <th>Mã phản ánh</th>
                        <th>Tiêu đề</th>
                        <th>Danh mục</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @($"PF{item.Id:D4}")
                                </strong>
                            </td>

                            <td>@item.Title</td>

                            <td>@item.CategoryName</td>

                            <td>
                                <span class="sf-state @StatusClass(item.Status)">
                                    @StatusText(item.Status)
                                </span>
                            </td>

                            <td>
                                @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <a asp-controller="Student"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="text-decoration-none">
                                    Xem chi tiết ↗
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="text-center text-secondary py-5">
                <div style="font-size:42px;">📭</div>

                @if (Model.TotalItems == 0 &&
                    string.IsNullOrWhiteSpace(Model.Search) &&
                    Model.Status == "all" &&
                    !Model.CategoryId.HasValue)
                {
                    <h5 class="mt-3">
                        Bạn chưa có phản ánh nào
                    </h5>
                    <p>
                        Hãy tạo phản ánh đầu tiên để gửi ý kiến.
                    </p>
                    <a asp-action="Create" class="sf-btn">
                        Tạo phản ánh
                    </a>
                }
                else
                {
                    <h5 class="mt-3">
                        Không tìm thấy phản ánh phù hợp
                    </h5>
                    <p>
                        Hãy thử thay đổi từ khóa hoặc bộ lọc.
                    </p>
                    <a asp-action="List" class="sf-btn">
                        Xóa bộ lọc
                    </a>
                }
            </div>
        }

        <!-- THÔNG TIN VÀ PHÂN TRANG -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-3 pt-3 border-top small text-secondary">

            <span>
                Hiển thị @startItem–@endItem
                trên tổng @Model.TotalItems phản ánh
            </span>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex flex-wrap gap-2">

                    @if (Model.Page > 1)
                    {
                        <a asp-action="List"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-page="@(Model.Page - 1)"
                           class="sf-page">
                            ‹ Trước
                        </a>
                    }

                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <a asp-action="List"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-page="@p"
                           class="sf-page @(p == Model.Page ? "active" : "")">
                            @p
                        </a>
                    }

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="List"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-page="@(Model.Page + 1)"
                           class="sf-page">
                            Sau ›
                        </a>
                    }
                </div>
            }
        </div>
    </section>
</div>
